{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-php",
      "runtimeExecutable": "C:/xampp/php/php.exe",
      "runtimeArgs": [
        "-S",
        "localhost:8000",
        "-t",
        "web"
      ],
      "port": 8000
    },
    {
      "name": "nodered-simulado",
